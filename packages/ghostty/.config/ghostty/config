# Ghostty's only config file. The macOS-specific one
# (~/Library/Application Support/com.mitchellh.ghostty/config.ghostty)
# used to load on top of this one; its settings are merged in below.

# Overridden by the iglass theme include at the bottom of this file:
# theme = "Aztec Sunset"

# ─────────── added by SpookiUI ───────────
font-family = "CommitMono Nerd Font Mono"
font-thicken = true
cursor-style = bar

custom-shader = ~/.config/ghostty/shaders/spookiui/_dim.glsl
custom-shader-animation = always

# Overridden by font-size = 13 below:
# font-size = 15

adjust-cell-width = -10%

# ─────────── merged from the macOS config.ghostty ───────────

# tmux integration - send save-buffer command
keybind = cmd+s=text:\x01\x73

# tmux prefix to toggle zoom on current pane
keybind = cmd+b=text:\x01\x7a

# aesthetics
background-opacity = 0.85
background-blur=16
background=#000000
#macos-titlebar-style = hidden

# typography
font-size=13
font-thicken-strength=1
adjust-cell-height=1
font-family = "JetBrains Mono"

# shaders

custom-shader = ~/.config/ghostty/shaders/cursor_warp.glsl

# Added by iglass (https://github.com/vukkt/iglass). Remove with: iglass uninstall
config-file = ?"~/.config/ghostty/iglass.ghostty"
